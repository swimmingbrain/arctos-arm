<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arctos_driver</name>
  <version>0.3.0</version>
  <description>ROS 2 driver node for the Arctos robot arm: joint states, FollowJointTrajectory and GripperCommand actions executed over CAN with the arctos python library</description>
  <maintainer email="braian.plaku@gmail.com">Braian Plaku</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
